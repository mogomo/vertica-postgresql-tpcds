                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              QUERY PLAN
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 ------------------------------
 QUERY PLAN DESCRIPTION:
 ------------------------------

 explain select  distinct(i_product_name)
  from item i1
  where i_manufact_id between 742 and 742+40
    and exists (select *
         from item
         where (i_manufact = i1.i_manufact and
         ((i_category = 'Women' and
         (i_color = 'orchid' or i_color = 'papaya') and
         (i_units = 'Pound' or i_units = 'Lb') and
         (i_size = 'petite' or i_size = 'medium')
         ) or
         (i_category = 'Women' and
         (i_color = 'burlywood' or i_color = 'navy') and
         (i_units = 'Bundle' or i_units = 'Each') and
         (i_size = 'N/A' or i_size = 'extra large')
         ) or
         (i_category = 'Men' and
         (i_color = 'bisque' or i_color = 'azure') and
         (i_units = 'N/A' or i_units = 'Tsp') and
         (i_size = 'small' or i_size = 'large')
         ) or
         (i_category = 'Men' and
         (i_color = 'chocolate' or i_color = 'cornflower') and
         (i_units = 'Bunch' or i_units = 'Gross') and
         (i_size = 'petite' or i_size = 'medium')
         ))) or
        (i_manufact = i1.i_manufact and
         ((i_category = 'Women' and
         (i_color = 'salmon' or i_color = 'midnight') and
         (i_units = 'Oz' or i_units = 'Box') and
         (i_size = 'petite' or i_size = 'medium')
         ) or
         (i_category = 'Women' and
         (i_color = 'snow' or i_color = 'steel') and
         (i_units = 'Carton' or i_units = 'Tbl') and
         (i_size = 'N/A' or i_size = 'extra large')
         ) or
         (i_category = 'Men' and
         (i_color = 'purple' or i_color = 'gainsboro') and
         (i_units = 'Dram' or i_units = 'Unknown') and
         (i_size = 'small' or i_size = 'large')
         ) or
         (i_category = 'Men' and
         (i_color = 'metallic' or i_color = 'forest') and
         (i_units = 'Gram' or i_units = 'Ounce') and
         (i_size = 'petite' or i_size = 'medium')
         ))))
  order by i_product_name
  limit 100;

 Access Path:
 +-SELECT  LIMIT 100 [Cost: 2K, Rows: 100] (PATH ID: 0)
 |  Output Only: 100 tuples
 | +---> GROUPBY HASH (SORT OUTPUT) (LOCAL RESEGMENT GROUPS) [Cost: 2K, Rows: 520] (PATH ID: 2)
 | |      Group By: i1.i_product_name
 | | +---> JOIN HASH [Semi] [Cost: 2K, Rows: 520] (PATH ID: 3)
 | | |      Join Cond: (VAL(1) = i1.i_manufact)
 | | |      Materialize at Output: i1.i_product_name
 | | | +-- Outer -> STORAGE ACCESS for i1 [Cost: 22, Rows: 1K] (PATH ID: 4)
 | | | |      Projection: tpcds_sf10.item_DBD_14_rep
 | | | |      Materialize: i1.i_manufact
 | | | |      Filter: ((i1.i_manufact_id >= 742) AND (i1.i_manufact_id <= 782))
 | | | |      Runtime Filter: (SIP1(HashJoin): i1.i_manufact)
 | | | +-- Inner -> SELECT [Cost: 2K, Rows: 12K] (PUSHED GROUPING) (PATH ID: 5)
 | | | | +---> STORAGE ACCESS for item [Cost: 2K, Rows: 12K] (PATH ID: 6)
 | | | | |      Projection: tpcds_sf10.item_DBD_13_rep
 | | | | |      Materialize: item.i_category, item.i_color, item.i_units, item.i_size, item.i_manufact
 | | | | |      Filter: (((item.i_category = 'Women') AND ((item.i_color = 'orchid') OR (item.i_color = 'papaya')) AND ((item.i_units = 'Pound') OR (item.i_units = 'Lb')) AND ((item.i_size = 'petite') OR (item.i_size = 'medium'))) OR ((item.i_category = 'Women') AND ((item.i_color = 'burlywood') OR (item.i_color = 'navy')) AND ((item.i_units = 'Bundle') OR (item.i_units = 'Each')) AND ((item.i_size = 'N/A') OR (item.i_size = 'extra large'))) OR ((item.i_category = 'Men') AND ((item.i_color = 'bisque') OR (item.i_color = 'azure')) AND ((item.i_units = 'N/A') OR (item.i_units = 'Tsp')) AND ((item.i_size = 'small') OR (item.i_size = 'large'))) OR ((item.i_category = 'Men') AND ((item.i_color = 'chocolate') OR (item.i_color = 'cornflower')) AND ((item.i_units = 'Bunch') OR (item.i_units = 'Gross')) AND ((item.i_size = 'petite') OR (item.i_size = 'medium'))) OR ((item.i_category = 'Women') AND ((item.i_color = 'salmon') OR (item.i_color = 'midnight')) AND ((item.i_units = 'Oz') OR (item.i_units = 'Box')) AND ((item.i_size = 'petite') OR (item.i_size = 'medium'))) OR ((item.i_category = 'Women') AND ((item.i_color = 'snow') OR (item.i_color = 'steel')) AND ((item.i_units = 'Carton') OR (item.i_units = 'Tbl')) AND ((item.i_size = 'N/A') OR (item.i_size = 'extra large'))) OR ((item.i_category = 'Men') AND ((item.i_color = 'purple') OR (item.i_color = 'gainsboro')) AND ((item.i_units = 'Dram') OR (item.i_units = 'Unknown')) AND ((item.i_size = 'small') OR (item.i_size = 'large'))) OR ((item.i_category = 'Men') AND ((item.i_color = 'metallic') OR (item.i_color = 'forest')) AND ((item.i_units = 'Gram') OR (item.i_units = 'Ounce')) AND ((item.i_size = 'petite') OR (item.i_size = 'medium'))))


