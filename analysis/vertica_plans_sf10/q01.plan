                                                                                                                                                                                                                                                                                                                                                                                                                 QUERY PLAN
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 ------------------------------
 QUERY PLAN DESCRIPTION:
 ------------------------------

 explain with customer_total_return as
 (select sr_customer_sk as ctr_customer_sk
 ,sr_store_sk as ctr_store_sk
 ,sum(SR_FEE) as ctr_total_return
 from store_returns
 ,date_dim
 where sr_returned_date_sk = d_date_sk
 and d_year =2000
 group by sr_customer_sk
 ,sr_store_sk)
  select  c_customer_id
 from customer_total_return ctr1
 ,store
 ,customer
 where ctr1.ctr_total_return > (select avg(ctr_total_return)*1.2
 from customer_total_return ctr2
 where ctr1.ctr_store_sk = ctr2.ctr_store_sk)
 and s_store_sk = ctr1.ctr_store_sk
 and s_state = 'SD'
 and ctr1.ctr_customer_sk = c_customer_sk
 order by c_customer_id
 limit 100;

 Access Path:
 +-SELECT  LIMIT 100 [Cost: 38K, Rows: 100] (PATH ID: 0)
 |  Output Only: 100 tuples
 | +---> SORT [TOPK] [Cost: 38K, Rows: 7K] (PATH ID: 1)
 | |      Order: customer.c_customer_id ASC
 | |      Output Only: 100 tuples
 | | +---> JOIN HASH [Cost: 38K, Rows: 7K] (PATH ID: 2)
 | | |      Join Cond: (store.s_store_sk = ctr1.ctr_store_sk)
 | | |      Materialize at Output: customer.c_customer_id
 | | | +-- Outer -> JOIN HASH [Cost: 36K, Rows: 14K] (PATH ID: 3)
 | | | |      Join Cond: (ctr1.ctr_store_sk = VAL(1))
 | | | |      Join Filter: (ctr1.ctr_total_return > VAL(4))
 | | | | +-- Outer -> JOIN MERGEJOIN(inputs presorted) [Cost: 22K, Rows: 14K] (PATH ID: 4)
 | | | | |      Join Cond: (ctr1.ctr_customer_sk = customer.c_customer_sk)
 | | | | | +-- Outer -> STORAGE ACCESS for customer [Cost: 1K, Rows: 500K] (PATH ID: 5)
 | | | | | |      Projection: tpcds_sf10.customer_DBD_21_rep
 | | | | | |      Materialize: customer.c_customer_sk
 | | | | | |      Runtime Filters: (SIP4(MergeJoin): customer.c_customer_sk), (SIP5(TopK): customer.c_customer_id)
 | | | | | +-- Inner -> TEMP RELATION ACCESS for TREL3 [Cost: 21K, Rows: 14K] (PATH ID: 6)
 | | | | | |      Filter: (ctr1.ctr_store_sk IS NOT NULL)
 | | | | | |      Filter: (ctr1.ctr_customer_sk IS NOT NULL)
 | | | | | |      Runtime Filters: (SIP3(HashJoin): ctr1.ctr_store_sk), (SIP2(HashJoin): ctr1.ctr_store_sk)
 | | | | | |      Path to compute TREL3 (printed once):
 | | | | | | +---> SELECT (TREL3) [Cost: 21K, Rows: 14K] (PATH ID: 7)
 | | | | | | | +---> GROUPBY PIPELINED [Cost: 21K, Rows: 14K] (PATH ID: 8)
 | | | | | | | |      Aggregates: sum(store_returns.sr_fee)
 | | | | | | | |      Group By: store_returns.sr_customer_sk, store_returns.sr_store_sk
 | | | | | | | | +---> JOIN HASH [Cost: 21K, Rows: 14K] (PATH ID: 9)
 | | | | | | | | |      Join Cond: (store_returns.sr_returned_date_sk = date_dim.d_date_sk)
 | | | | | | | | |      Materialize at Output: store_returns.sr_customer_sk, store_returns.sr_store_sk, store_returns.sr_fee
 | | | | | | | | | +-- Outer -> STORAGE ACCESS for store_returns [Cost: 7K, Rows: 3M] (PATH ID: 10)
 | | | | | | | | | |      Projection: tpcds_sf10.store_returns_DBD_24_rep
 | | | | | | | | | |      Materialize: store_returns.sr_returned_date_sk
 | | | | | | | | | |      Filter: (store_returns.sr_returned_date_sk IS NOT NULL)
 | | | | | | | | | |      Runtime Filter: (SIP1(HashJoin): store_returns.sr_returned_date_sk)
 | | | | | | | | | +-- Inner -> STORAGE ACCESS for date_dim [Cost: 20, Rows: 367] (PATH ID: 11)
 | | | | | | | | | |      Projection: tpcds_sf10.date_dim_DBD_5_rep
 | | | | | | | | | |      Materialize: date_dim.d_date_sk
 | | | | | | | | | |      Filter: (date_dim.d_year = 2000)
 | | | | +-- Inner -> SELECT [Cost: 14K, Rows: 1] (PATH ID: 12)
 | | | | | +---> GROUPBY HASH (LOCAL RESEGMENT GROUPS) [Cost: 14K, Rows: 1] (PATH ID: 13)
 | | | | | |      Aggregates: sum_float(ctr2.ctr_total_return), count(ctr2.ctr_total_return)
 | | | | | |      Group By: ctr2.ctr_store_sk
 | | | | | | +---> TEMP RELATION ACCESS for TREL3 [Cost: 14K, Rows: 14K] (PATH ID: 14)
 | | | +-- Inner -> STORAGE ACCESS for store [Cost: 35, Rows: 50] (PATH ID: 15)
 | | | |      Projection: tpcds_sf10.store_DBD_17_rep
 | | | |      Materialize: store.s_store_sk
 | | | |      Filter: (store.s_state = 'SD')


