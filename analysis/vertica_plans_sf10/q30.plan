                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               QUERY PLAN
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 ------------------------------
 QUERY PLAN DESCRIPTION:
 ------------------------------

 explain with customer_total_return as
  (select wr_returning_customer_sk as ctr_customer_sk
         ,ca_state as ctr_state,
  	sum(wr_return_amt) as ctr_total_return
  from web_returns
      ,date_dim
      ,customer_address
  where wr_returned_date_sk = d_date_sk
    and d_year =2002
    and wr_returning_addr_sk = ca_address_sk
  group by wr_returning_customer_sk
          ,ca_state)
   select  c_customer_id,c_salutation,c_first_name,c_last_name,c_preferred_cust_flag
        ,c_birth_day,c_birth_month,c_birth_year,c_birth_country,c_login,c_email_address
        ,c_last_review_date_sk,ctr_total_return
  from customer_total_return ctr1
      ,customer_address
      ,customer
  where ctr1.ctr_total_return > (select avg(ctr_total_return)*1.2
  			  from customer_total_return ctr2
                   	  where ctr1.ctr_state = ctr2.ctr_state)
        and ca_address_sk = c_current_addr_sk
        and ca_state = 'IL'
        and ctr1.ctr_customer_sk = c_customer_sk
  order by c_customer_id,c_salutation,c_first_name,c_last_name,c_preferred_cust_flag
                   ,c_birth_day,c_birth_month,c_birth_year,c_birth_country,c_login,c_email_address
                   ,c_last_review_date_sk,ctr_total_return
 limit 100;

 Access Path:
 +-SELECT  LIMIT 100 [Cost: 26K, Rows: 100] (PATH ID: 0)
 |  Output Only: 100 tuples
 | +---> SORT [TOPK] [Cost: 26K, Rows: 100] (PATH ID: 1)
 | |      Order: customer.c_customer_id ASC, customer.c_salutation ASC, customer.c_first_name ASC, customer.c_last_name ASC, customer.c_preferred_cust_flag ASC, customer.c_birth_day ASC, customer.c_birth_month ASC, customer.c_birth_year ASC, customer.c_birth_country ASC, customer.c_login ASC, customer.c_email_address ASC, customer.c_last_review_date_sk ASC, ctr1.ctr_total_return ASC
 | |      Output Only: 100 tuples
 | | +---> JOIN HASH [Cost: 26K, Rows: 100] (PATH ID: 2)
 | | |      Join Cond: (ctr1.ctr_state = VAL(1))
 | | |      Join Filter: (ctr1.ctr_total_return > VAL(4))
 | | |      Materialize at Output: customer.c_customer_id, customer.c_salutation, customer.c_first_name, customer.c_last_name, customer.c_preferred_cust_flag, customer.c_birth_day, customer.c_birth_month, customer.c_birth_year, customer.c_birth_country, customer.c_login, customer.c_email_address, customer.c_last_review_date_sk
 | | | +-- Outer -> JOIN MERGEJOIN(inputs presorted) [Cost: 10K, Rows: 100] (PATH ID: 3)
 | | | |      Join Cond: (ctr1.ctr_customer_sk = customer.c_customer_sk)
 | | | |      Materialize at Input: customer.c_customer_sk
 | | | | +-- Outer -> JOIN HASH [Cost: 1K, Rows: 15K] (PATH ID: 4)
 | | | | |      Join Cond: (customer_address.ca_address_sk = customer.c_current_addr_sk)
 | | | | | +-- Outer -> STORAGE ACCESS for customer [Cost: 1K, Rows: 500K] (PATH ID: 5)
 | | | | | |      Projection: tpcds_sf10.customer_DBD_21_rep
 | | | | | |      Materialize: customer.c_current_addr_sk
 | | | | | |      Filter: (customer.c_current_addr_sk IS NOT NULL)
 | | | | | |      Runtime Filters: (SIP5(HashJoin): customer.c_current_addr_sk), (SIP4(MergeJoin): customer.c_customer_sk), (SIP6(TopK): customer.c_customer_id)
 | | | | | +-- Inner -> STORAGE ACCESS for customer_address [Cost: 55, Rows: 8K] (PATH ID: 6)
 | | | | | |      Projection: tpcds_sf10.customer_address_DBD_1_rep
 | | | | | |      Materialize: customer_address.ca_address_sk
 | | | | | |      Filter: (customer_address.ca_state = 'IL')
 | | | | +-- Inner -> TEMP RELATION ACCESS for TREL3 [Cost: 8K, Rows: 3K] (PATH ID: 7)
 | | | | |      Filter: (ctr1.ctr_customer_sk IS NOT NULL)
 | | | | |      Runtime Filter: (SIP3(HashJoin): ctr1.ctr_state)
 | | | | |      Path to compute TREL3 (printed once):
 | | | | | +---> SELECT (TREL3) [Cost: 8K, Rows: 3K] (PATH ID: 8)
 | | | | | | +---> GROUPBY HASH (LOCAL RESEGMENT GROUPS) [Cost: 8K, Rows: 3K] (PATH ID: 9)
 | | | | | | |      Aggregates: sum(web_returns.wr_return_amt)
 | | | | | | |      Group By: web_returns.wr_returning_customer_sk, customer_address.ca_state
 | | | | | | | +---> JOIN HASH [Cost: 8K, Rows: 3K] (PATH ID: 10)
 | | | | | | | |      Join Cond: (web_returns.wr_returning_addr_sk = customer_address.ca_address_sk)
 | | | | | | | |      Materialize at Input: web_returns.wr_returning_addr_sk
 | | | | | | | |      Materialize at Output: web_returns.wr_returning_customer_sk, web_returns.wr_return_amt
 | | | | | | | | +-- Outer -> JOIN HASH [Cost: 3K, Rows: 3K] (PATH ID: 11)
 | | | | | | | | |      Join Cond: (web_returns.wr_returned_date_sk = date_dim.d_date_sk)
 | | | | | | | | | +-- Outer -> STORAGE ACCESS for web_returns [Cost: 3K, Rows: 656K] (PATH ID: 12)
 | | | | | | | | | |      Projection: tpcds_sf10.web_returns_DBD_33_rep
 | | | | | | | | | |      Materialize: web_returns.wr_returned_date_sk
 | | | | | | | | | |      Filter: (web_returns.wr_returned_date_sk IS NOT NULL)
 | | | | | | | | | |      Filter: (web_returns.wr_returning_addr_sk IS NOT NULL)
 | | | | | | | | | |      Runtime Filters: (SIP2(HashJoin): web_returns.wr_returned_date_sk), (SIP1(HashJoin): web_returns.wr_returning_addr_sk)
 | | | | | | | | | +-- Inner -> STORAGE ACCESS for date_dim [Cost: 20, Rows: 367] (PATH ID: 13)
 | | | | | | | | | |      Projection: tpcds_sf10.date_dim_DBD_5_rep
 | | | | | | | | | |      Materialize: date_dim.d_date_sk
 | | | | | | | | | |      Filter: (date_dim.d_year = 2002)
 | | | | | | | | +-- Inner -> STORAGE ACCESS for customer_address [Cost: 643, Rows: 250K] (PATH ID: 14)
 | | | | | | | | |      Projection: tpcds_sf10.customer_address_DBD_1_rep
 | | | | | | | | |      Materialize: customer_address.ca_state, customer_address.ca_address_sk
 | | | +-- Inner -> SELECT [Cost: 6K, Rows: 1] (PATH ID: 15)
 | | | | +---> GROUPBY HASH (LOCAL RESEGMENT GROUPS) [Cost: 6K, Rows: 1] (PATH ID: 16)
 | | | | |      Aggregates: sum_float(ctr2.ctr_total_return), count(ctr2.ctr_total_return)
 | | | | |      Group By: ctr2.ctr_state
 | | | | | +---> TEMP RELATION ACCESS for TREL3 [Cost: 6K, Rows: 3K] (PATH ID: 17)


