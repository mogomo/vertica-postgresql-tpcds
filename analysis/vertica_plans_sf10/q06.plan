                                                                                                                                                                                                                                                                                                                                                                                                                                     QUERY PLAN
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 ------------------------------
 QUERY PLAN DESCRIPTION:
 ------------------------------

 explain select  a.ca_state state, count(*) cnt
  from customer_address a
      ,customer c
      ,store_sales s
      ,date_dim d
      ,item i
  where       a.ca_address_sk = c.c_current_addr_sk
  	and c.c_customer_sk = s.ss_customer_sk
  	and s.ss_sold_date_sk = d.d_date_sk
  	and s.ss_item_sk = i.i_item_sk
  	and d.d_month_seq =
  	     (select distinct (d_month_seq)
  	      from date_dim
                where d_year = 2000
  	        and d_moy = 2 )
  	and i.i_current_price > 1.2 *
              (select avg(j.i_current_price)
  	     from item j
  	     where j.i_category = i.i_category)
  group by a.ca_state
  having count(*) >= 10
  order by cnt, a.ca_state
  limit 100;

 Access Path:
 +-SELECT  LIMIT 100 [Cost: 422K, Rows: 100] (PATH ID: 0)
 | +---> SORT [Cost: 422K, Rows: 52] (PATH ID: 1)
 | |      Order: count(*) ASC, a.ca_state ASC
 | | +---> GROUPBY HASH (LOCAL RESEGMENT GROUPS) [Cost: 422K, Rows: 52] (PATH ID: 2)
 | | |      Aggregates: count(*)
 | | |      Group By: a.ca_state
 | | |      Filter: (<SVAR> >= 10)
 | | | +---> JOIN HASH [Cost: 310K, Rows: 26M] (PATH ID: 3)
 | | | |      Join Cond: (d.d_month_seq = VAL(6))
 | | | | +-- Outer -> JOIN HASH [Cost: 188K, Rows: 26M] (PATH ID: 4)
 | | | | |      Join Cond: (s.ss_item_sk = i.i_item_sk)
 | | | | |      Materialize at Input: s.ss_item_sk, i.i_category, i.i_current_price, i.i_item_sk
 | | | | | +-- Outer -> JOIN HASH [Cost: 105K, Rows: 26M] (PATH ID: 5)
 | | | | | |      Join Cond: (s.ss_sold_date_sk = d.d_date_sk)
 | | | | | |      Materialize at Input: s.ss_sold_date_sk
 | | | | | | +-- Outer -> JOIN HASH [Cost: 81K, Rows: 26M] (PATH ID: 6)
 | | | | | | |      Join Cond: (c.c_customer_sk = s.ss_customer_sk)
 | | | | | | |      Materialize at Input: c.c_current_addr_sk, c.c_customer_sk
 | | | | | | | +-- Outer -> STORAGE ACCESS for s [Cost: 66K, Rows: 26M] (PATH ID: 7)
 | | | | | | | |      Projection: tpcds_sf10.store_sales_DBD_41_rep
 | | | | | | | |      Materialize: s.ss_customer_sk
 | | | | | | | |      Filter: (s.ss_sold_date_sk IS NOT NULL)
 | | | | | | | |      Filter: (s.ss_customer_sk IS NOT NULL)
 | | | | | | | |      Runtime Filters: (SIP4(HashJoin): s.ss_customer_sk), (SIP3(HashJoin): s.ss_sold_date_sk), (SIP2(HashJoin): s.ss_item_sk)
 | | | | | | | +-- Inner -> JOIN HASH [Cost: 2K, Rows: 500K (192K RLE)] (PATH ID: 8)
 | | | | | | | |      Join Cond: (a.ca_address_sk = c.c_current_addr_sk)
 | | | | | | | | +-- Outer -> STORAGE ACCESS for c [Cost: 924, Rows: 500K (192K RLE)] (PATH ID: 9)
 | | | | | | | | |      Projection: tpcds_sf10.customer_DBD_23_rep
 | | | | | | | | |      Materialize: c.c_current_addr_sk
 | | | | | | | | |      Filter: (c.c_current_addr_sk IS NOT NULL)
 | | | | | | | | |      Runtime Filter: (SIP5(HashJoin): c.c_current_addr_sk)
 | | | | | | | | +-- Inner -> STORAGE ACCESS for a [Cost: 643, Rows: 250K] (PATH ID: 10)
 | | | | | | | | |      Projection: tpcds_sf10.customer_address_DBD_1_rep
 | | | | | | | | |      Materialize: a.ca_state, a.ca_address_sk
 | | | | | | +-- Inner -> STORAGE ACCESS for d [Cost: 490, Rows: 73K] (PATH ID: 11)
 | | | | | | |      Projection: tpcds_sf10.date_dim_DBD_4_rep
 | | | | | | |      Materialize: d.d_date_sk, d.d_month_seq
 | | | | | | |      Runtime Filter: (SIP1(HashJoin): d.d_month_seq)
 | | | | | +-- Inner -> JOIN MERGEJOIN(inputs presorted) [Cost: 860, Rows: 102K] (PATH ID: 12)
 | | | | | |      Join Cond: (VAL(1) = i.i_category)
 | | | | | |      Join Filter: (i.i_current_price > (1.2 * VAL(7)))
 | | | | | | +-- Outer -> STORAGE ACCESS for i [Cost: 265, Rows: 102K] (PATH ID: 13)
 | | | | | | |      Projection: tpcds_sf10.item_DBD_13_rep
 | | | | | | |      Materialize: i.i_category, i.i_current_price
 | | | | | | |      Runtime Filter: (SIP6(MergeJoin): i.i_category)
 | | | | | | +-- Inner -> SELECT [Cost: 430, Rows: 11] (PATH ID: 14)
 | | | | | | | +---> GROUPBY PIPELINED [Cost: 430, Rows: 11] (PATH ID: 15)
 | | | | | | | |      Aggregates: sum_float(j.i_current_price), count(j.i_current_price)
 | | | | | | | |      Group By: j.i_category
 | | | | | | | | +---> STORAGE ACCESS for j [Cost: 265, Rows: 102K] (PATH ID: 16)
 | | | | | | | | |      Projection: tpcds_sf10.item_DBD_13_rep
 | | | | | | | | |      Materialize: j.i_category, j.i_current_price
 | | | | +-- Inner -> SELECT [Cost: 23, Rows: 1] (PATH ID: 17)
 | | | | | +---> GROUPBY HASH (LOCAL RESEGMENT GROUPS) [Cost: 23, Rows: 30] (PATH ID: 18)
 | | | | | |      Group By: date_dim.d_month_seq
 | | | | | | +---> STORAGE ACCESS for date_dim [Cost: 22, Rows: 30] (PATH ID: 19)
 | | | | | | |      Projection: tpcds_sf10.date_dim_DBD_4_rep
 | | | | | | |      Materialize: date_dim.d_month_seq
 | | | | | | |      Filter: (date_dim.d_year = 2000)
 | | | | | | |      Filter: (date_dim.d_moy = 2)


