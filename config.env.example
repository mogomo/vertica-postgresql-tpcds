# TPC-DS benchmark - settings.
# Copy to config.env and adjust (config.env is git-ignored). Any value can
# also be overridden from the environment, e.g.:  SCALE=10 ./tpcds.sh all

# --- Database product ---------------------------------------------------------
PRODUCT=${PRODUCT:-vertica}     # vertica or postgresql (scripts/<product>/)
SCHEMA=${SCHEMA:-tpcds}         # dropped and re-created by the "schema" step

# --- Vertica ------------------------------------------------------------------
VSQL=${VSQL:-/opt/vertica/bin/vsql}
DB_HOST=${DB_HOST:-}            # empty = local socket (run on the Vertica node)
DB_PORT=${DB_PORT:-5433}
DB_NAME=${DB_NAME:-}            # empty = default database
DB_USER=${DB_USER:-dbadmin}
DB_PASSWORD=${DB_PASSWORD:-}
PROJECTIONS=${PROJECTIONS:-designed}   # designed = create sql/vertica/projections/sf<SCALE>_<nodes>node.sql
                                       # before the load; default = Vertica's automatic super-projections
DESIGN_SAMPLE_ROWS=${DESIGN_SAMPLE_ROWS:-10000000}   # store_sales rows in the design sample
CHECK_ITERATIONS=${CHECK_ITERATIONS:-2}  # query runs of the "check" step (best time counts)
# Dedicated resource pool for the query sessions. The general pool plans for one
# query per CPU thread, so each query gets only 1/threads of the memory; for a
# single-stream power run a small planned concurrency gives every query more memory.
# Empty POOL_CONCURRENCY = use the general pool as it is.
POOL_CONCURRENCY=${POOL_CONCURRENCY:-2}
POOL_MEMORY=${POOL_MEMORY:-65%}         # memory reserved for that pool during the run (max ~65%:
                                        # the general pool must keep >= 25%); released afterwards
POOL_NAME=${POOL_NAME:-tpcds_pool}

# --- PostgreSQL ---------------------------------------------------------------
PG_VERSION=${PG_VERSION:-18}            # major version installed by scripts/postgresql/install.sh
PG_DATA_DIR=${PG_DATA_DIR:-/var/lib/postgresql/$PG_VERSION/main}   # install.sh: data directory
PG_LOG_DIR=${PG_LOG_DIR:-/var/log/postgresql/tpcds}   # install.sh: server log (jsonlog), read by the run step
PG_CONF=${PG_CONF:-tuned}               # install.sh: sql/postgresql/<PG_CONF>.conf is included by postgresql.conf
PG_HOST=${PG_HOST:-}                    # empty = local socket
PG_PORT=${PG_PORT:-5432}
PG_DB=${PG_DB:-tpcds}                   # database that holds the benchmark schemas
PG_USER=${PG_USER:-$(id -un)}           # install.sh creates this role (superuser)
PG_COPY_STREAMS=${PG_COPY_STREAMS:-6}   # flat files of one table loaded concurrently (one COPY each)
PG_INDEXES=${PG_INDEXES:-yes}           # yes = primary keys and sql/postgresql/indexes.sql after the load

# --- Benchmark ----------------------------------------------------------------
SCALE=${SCALE:-1}               # TPC-DS scale factor, ~1 GB raw data per unit
JOBS=${JOBS:-$(nproc)}          # parallel dsdgen processes
LOAD_JOBS=${LOAD_JOBS:-4}       # tables loaded concurrently
ITERATIONS=${ITERATIONS:-3}     # how many times the 99 queries are run
QUERY_TIMEOUT=${QUERY_TIMEOUT:-3600}   # seconds per query (when no budget file is given)
QUERY_BUDGETS=${QUERY_BUDGETS:-}       # CSV query,seconds: time limit per query (./tpcds.sh budgets);
                                       # a query over its limit is not run again in later iterations
QUERIES=${QUERIES:-}            # empty = all 99; e.g. "04 14 78" runs only these queries
RUN_LABEL=${RUN_LABEL:-tuned}   # free text, part of the results folder name

# --- Paths --------------------------------------------------------------------
WORK_DIR=${WORK_DIR:-$REPO_DIR/work}            # toolkit, data, queries, output
DATA_DIR=${DATA_DIR:-$WORK_DIR/data/sf$SCALE}   # flat files; must be readable by the database server
KEEP_DATA=${KEEP_DATA:-yes}     # "no" = delete the flat files of each table once it is loaded

# --- Video (video/audio.py) -----------------------------------------------------
NARRATION_DIR=${NARRATION_DIR:-$REPO_DIR/work/narration}   # the recordings s00.mp3 ... s10.mp3
MUSIC_SRC=${MUSIC_SRC:-}                                    # the music track (WAV)
